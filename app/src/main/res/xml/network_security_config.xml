<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Match komi-store: all repository, download and translation traffic is HTTPS. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
